{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM", "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "app/**/*.ts",
    "src/**/*.ts",
    "version.js"
  ]
}
