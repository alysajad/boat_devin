# Local server overrides. All are optional.
APP_PORT=8080
WS_PORT=6020
API_PORT=6120

# Supply a stable public origin, or leave blank and use `npm run event` for a
# temporary Cloudflare Quick Tunnel.
PUBLIC_ORIGIN=
CLOUDFLARED_BIN=cloudflared
TUNNEL_TRANSPORT=http2
TUNNEL_EDGE_IP_VERSION=4

# Trusted local HTTPS for phone motion controls. Use absolute certificate paths.
TLS_CERT=
TLS_KEY=
HTTPS_PORT=8443

# Docker/Caddy deployment. Point SITE_ADDRESS at the deployed server.
SITE_ADDRESS=race.example.com
HTTP_PORT=80
